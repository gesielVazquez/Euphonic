# Generar la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=euphonic-id2r.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://euphonic-id2r.onrender.com

# Solo si el hosting exige PostgreSQL. En local se usa SQLite (sin esta variable).
DATABASE_URL=postgres://usuario:password@host:5432/euphonic

# Usuarios iniciales (los crea manage.py setup_users en cada build).
# El admin es superusuario; los USER{n} son usuarios normales.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@euphonic.app

# Para agregar otro integrante de la banda alcanza con sumar un bloque más
# USER{n}_USERNAME / USER{n}_PASSWORD (n = 1, 2, 3, ...). No hay que tocar código.
USER1_USERNAME=user1
USER1_PASSWORD=

USER2_USERNAME=user2
USER2_PASSWORD=